#
# This configuration provides consistent code formatting rules across
# different editors and IDEs. The .NET-specific rules were removed together
# with the C# support; see README.md for the fork attribution.
#
# For more information about EditorConfig, visit: https://editorconfig.org
#
##########################################


##########################################
# Common Settings
##########################################

root = true

# All Files
[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 180

##########################################
# File Extension Settings
##########################################

# GDScript Godot files
[*.gd]
indent_style = tab

# XML and configuration files
[*.{xml,config}]
indent_size = 2

# JSON Files
[*.{json,json5,webmanifest}]
indent_size = 2

# YAML Files
[*.{yml,yaml}]
indent_size = 2
end_of_line = lf

# Markdown Files
[*.{md,mdx}]
trim_trailing_whitespace = false

# Web Files
[*.{htm,html,js,jsm,ts,tsx,cjs,cts,ctsx,mjs,mts,mtsx,css,sass,scss,less,pcss,svg,vue}]
indent_size = 2

# Batch Files
[*.{cmd,bat}]
end_of_line = crlf

# Bash Files
[*.sh]
end_of_line = lf

# Makefiles
[Makefile]
indent_style = tab

